{
  "manifest_version": 3,
  "name": "Recortar e Traduzir",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}